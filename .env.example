PORT=3000
NODE_ENV=development
APP_VERSION=0.1.0
RELEASE_SHA=local
RELEASE_CREATED_AT=2026-05-02T00:00:00Z

DB_HOST=your-host
DB_PORT=3306
DB_NAME=your-database
DB_USER=your-user
DB_PASSWORD=your-password
DATABASE_URL=mysql://user:password@host:3306/database

DB_DIRECT_HOST=your-direct-host
DB_DIRECT_PORT=12306
DB_DIRECT_URL=mysql://user:password@direct-host:12306/database

JWT_ACCESS_SECRET=replace_with_strong_secret
JWT_REFRESH_SECRET=replace_with_strong_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
ALLOWED_ORIGINS=https://monraspgit.github.io
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20

# Judge email verification
JUEZ_FRONTEND_URL=http://localhost:5173
JUEZ_EMAIL_VERIFICATION_TTL_HOURS=48

MAIL_FROM=SaasPro <no-reply@saaspro.local>

# QZ Tray (frontend-joker) print signing: certificado + clave privada
# generados una sola vez con openssl. El navegador pide el certificado
# publico en /joker/qz-certificate y firma cada conexion via /joker/qz-sign,
# asi QZ Tray no vuelve a preguntar "Signature (missing) / Validity (invalid)".
# Formato: el PEM con los saltos de linea reemplazados por \n literal.
QZ_CERTIFICATE="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n"
QZ_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=your-smtp-user
MAIL_PASS=your-smtp-password
MAIL_SECURE=false

# Camisetas (Mercado Pago Checkout Pro): access token de la cuenta de
# Mercado Pago del vendedor. Sin esto, /camisetas/checkout devuelve error.
MP_ACCESS_TOKEN=replace_with_mercadopago_access_token
CAMISETAS_FRONTEND_URL=https://monraspgit.github.io/frontend-camisetas/
CAMISETAS_BACKEND_URL=https://saasproback.onrender.com

# DGI / facturacion electronica (proveedor: facturaelectronica.com.uy - FEU)
# environment "test" pega contra el sandbox de FEU (urls por defecto ya
# apuntan ahi, no hace falta llenarlas). Para produccion hay que pedirle a
# FEU las URLs reales y completar los *_PROD.
DGI_FEU_ENVIRONMENT=test
DGI_FEU_USERNAME=replace_with_feu_test_username
DGI_FEU_PASSWORD=replace_with_feu_test_password
DGI_FEU_SUCURSAL=1
DGI_FEU_RUT_EMISOR=replace_with_rut
DGI_FEU_AUTH_URL_TEST=https://auth-test.facturaelectronica.com.uy/token
DGI_FEU_API_URL_TEST=https://api-test.facturaelectronica.com.uy
DGI_FEU_AUTH_URL_PROD=
DGI_FEU_API_URL_PROD=
